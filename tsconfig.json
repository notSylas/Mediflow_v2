{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "~backend/*": ["./backend/*"],
      "@/*": ["./web/*"]
    }
  },
  "include": [
    "web/next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "web/.next/types/**/*.ts",
    "web/.next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "mobile", "vitest.config.ts", "playwright.config.ts"]
}
