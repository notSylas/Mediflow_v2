# Build context exclusions (the dev image only needs package*.json for `npm ci`;
# source is bind-mounted at runtime). Keeps the context small and secrets out.
node_modules
**/node_modules
.next
**/.next
.git
.github
mobile
e2e
test-results
playwright-report
coverage
drizzle/meta
*.log
.env
.env.*
# Local credential files — these are NOT matched by .env* and would otherwise
# be copied into the image by `COPY . .`.
.db-root-password.txt
.db-app-password.txt
.cron-secret.txt
certs
.DS_Store
README.md
docs
load

# prescription-analyzer: never ship the local venv, the local FastAPI server,
# the zero-build demo page, or the sample prescription PDF into an image.
prescription-analyzer/.venv
prescription-analyzer/api.py
prescription-analyzer/main.py
prescription-analyzer/web
prescription-analyzer/*.pdf
prescription-analyzer/result.json
**/__pycache__
*.pyc
