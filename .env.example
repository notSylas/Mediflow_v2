# Postgres connection string (Neon, or local Docker Postgres for dev)
DATABASE_URL=postgresql://mediflow:mediflow_dev@localhost:5433/mediflow
# App DB pool size. Keep low in local Next dev to avoid Postgres "too many clients".
# POSTGRES_MAX_CONNECTIONS=5

# Better Auth — generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional in dev; email OTP works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Milestone 3: payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Milestone 4: video
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Email (Resend). Unset = emails print to the server console (dev only).
RESEND_API_KEY=
# Verified sender. Use your own verified domain in production.
# EMAIL_FROM="MediFlow <noreply@yourdomain.com>"

# Secret Vercel Cron or any scheduler must present to trigger /api/cron/reminders
# (Authorization: Bearer <CRON_SECRET>). Required in production.
# CRON_SECRET=

# Vault Share envelope encryption (docs/designs/vault-share-trd.md §5).
# Unset in dev = a local software fallback derived from BETTER_AUTH_SECRET
# (see src/lib/vault/vault-crypto.ts) — fully functional for testing, but
# vault sharing refuses to run in production without a real KMS key.
# AWS_KMS_KEY_ID=
# AWS_REGION=ap-south-1

# Error monitoring (optional; unset disables Sentry entirely)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Logging (optional; defaults to "debug" in dev, "info" in production)
# LOG_LEVEL=

# --- Realtime chat (self-hosted socket.io: `npm run realtime`) ---
# Public URL the browser/app connects to. Unset = derived from the page host on
# port 4000 (dev). In production set to the deployed socket server's URL.
# NEXT_PUBLIC_REALTIME_URL=https://realtime.yourdomain.com
# Port the socket server listens on (default 4000).
# REALTIME_PORT=4000
# HMAC secret for socket tokens. Falls back to BETTER_AUTH_SECRET if unset.
# REALTIME_SECRET=
# Comma-separated browser origins allowed to connect (native apps are exempt).
# Default covers local dev only — set this in production.
# REALTIME_ALLOWED_ORIGINS=https://app.yourdomain.com

# --- Standalone backend API (`npm run backend`) ---
# Origin where the backend process is reachable. When set, the web app proxies
# the endpoints listed in backend/api/routes.json to it (same-origin rewrite, so
# session cookies keep working); everything else stays in-process. Unset = the
# web app serves the whole API itself, which is the current default.
#
# NOTE: Next bakes rewrites into the build, so this must be set at BUILD time,
# not just at runtime — `BACKEND_ORIGIN=... npm run build`. (In `next dev` the
# config is re-evaluated, so runtime is enough there.)
# BACKEND_ORIGIN=http://localhost:4100
# Port the backend listens on (default 4100; Cloud Run injects PORT).
# BACKEND_PORT=4100
