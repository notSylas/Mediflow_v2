# --- LLM provider: "openai" (default) or "ollama" ---
LLM_PROVIDER=openai

# OpenAI (vision-capable model required, e.g. gpt-4o)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Ollama (vision model, e.g. qwen2.5vl:32b) — used only when LLM_PROVIDER=ollama
OLLAMA_HOST=http://10.60.61.147:11434
OLLAMA_MODEL=qwen2.5vl:32b

# Rendering DPI for PDF pages (higher = sharper handwriting, slower)
RENDER_DPI=300
