# Production image for the MediFlow website (web/).
#
# Ships Next's traced standalone bundle (~54 MB) rather than a full
# node_modules. The Next project root is web/, so the standalone output nests
# as standalone/web/server.js — hence the paths below.
#
#   docker build -f Dockerfile.web \
#     --build-arg BACKEND_ORIGIN=https://<backend-url> -t mediflow-web .
#
# BACKEND_ORIGIN is a BUILD arg, not a runtime env var, on purpose: Next bakes
# rewrites into routes-manifest.json at build time, so setting it only at
# runtime silently leaves every /api/* call handled in-process instead of
# being proxied to the backend service.

# ---- deps ----------------------------------------------------------------
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# ---- build ---------------------------------------------------------------
FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG BACKEND_ORIGIN=""
ENV BACKEND_ORIGIN=$BACKEND_ORIGIN
ENV NEXT_TELEMETRY_DISABLED=1
# Page-data collection evaluates modules that construct the DB client, which
# throws unless DATABASE_URL is set. Nothing connects during the build — every
# route is dynamic — so a syntactically valid placeholder is enough. The real
# value is injected at runtime from Secret Manager.
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
RUN npm run build

# ---- runtime -------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
# Bind all interfaces; Cloud Run injects PORT and health-checks it.
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
# Small pool: the web app opens its own connections to the same db-f1-micro
# instance the backend uses, and that allows ~25 in total.
ENV POSTGRES_MAX_CONNECTIONS=3
ENV LOG_LEVEL=info

# Build provenance, surfaced on the login page so testers can report bugs
# against a specific build. Baked into the image rather than set at deploy
# time, so it always describes what is actually running.
ARG GIT_SHA=""
ARG GIT_REF=""
ARG BUILD_TIME=""
ENV COMMIT_SHA=$GIT_SHA
ENV COMMIT_REF=$GIT_REF
ENV BUILD_TIME=$BUILD_TIME

COPY --from=builder /app/web/.next/standalone ./
# The minimal server doesn't include these two by default.
COPY --from=builder /app/web/.next/static ./web/.next/static
COPY --from=builder /app/web/public ./web/public

USER node
EXPOSE 3000
CMD ["node", "web/server.js"]
